# ==============================================================================
# Python Code Execution Sandbox - Environment Configuration Reference
# ==============================================================================

# Hard wall-clock limit per execution in seconds (default: 3)
EXECUTION_TIMEOUT=3

# Extra time allowed in seconds for kill/remove before API gives up (default: 2)
TIMEOUT_GRACE_PERIOD=2

# Docker memory limit (e.g. 50m)
MEMORY_LIMIT=50m

# Docker memory+swap limit (MUST equal MEMORY_LIMIT to disable swap) (default: 50m)
MEMSWAP_LIMIT=50m

# Docker CPU limit in nano_cpus (500000000 = 0.5 vCPU)
CPU_NANO=500000000

# Maximum processes/threads inside container (pids_limit) (default: 64)
PIDS_LIMIT=64

# Size cap for the container's writable /tmp tmpfs mount (default: 16m)
TMPFS_SIZE=16m

# Maximum accepted source code size in bytes (UTF-8 encoded) (default: 32768)
MAX_CODE_SIZE=32768

# Maximum accepted source code line count (default: 1000)
MAX_CODE_LINES=1000

# Combined stdout+stderr output cap in bytes before truncation (default: 65536)
MAX_OUTPUT_SIZE=65536

# Maximum concurrent executions allowed before returning 503 at_capacity (default: 10)
MAX_CONCURRENT_EXECUTIONS=10

# Per-IP rate limit enforced via Flask-Limiter (default: 20/minute)
RATE_LIMIT=20/minute

# Storage URI for rate limiter: memory:// for local dev, redis://<host>:6379/0 for production
RATE_LIMIT_STORAGE_URI=memory://

# Tag of the hardened execution sandbox Docker image
EXECUTION_IMAGE=python-sandbox-exec:latest

# Staging root directory for per-execution script.py (tmpfs /dev/shm/sandbox preferred, fallback ./sandbox)
STAGING_ROOT=/dev/shm/sandbox

# Client-level HTTP timeout in seconds for Docker SDK calls (default: 10)
DOCKER_TIMEOUT=10

# Integration API persistence and embedding
# Default stores integration records in instance/integration.sqlite3.
INTEGRATION_DATABASE=instance/integration.sqlite3
# Set a long, random FLASK_SECRET_KEY before issuing candidate session tokens.
FLASK_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
# Comma-separated trusted origins allowed to iframe /embed/editor, e.g. https://lms.example.edu
EMBED_ALLOWED_ORIGINS=

# Retain completed execution containers briefly for Docker Desktop inspection
SANDBOX_DEBUG_MODE=true
SANDBOX_KEEP_CONTAINERS=true
SANDBOX_CONTAINER_CLEANUP_DELAY=30
SANDBOX_AUTO_REMOVE=false
SANDBOX_CONTAINER_PREFIX=sandbox-exec
